. do stata_bench.do 

. * Times Stata clogit on the scenarios in data/ (run scenarios.jl first).
. *
. *   cd benchmark/compare
. *   stata-mp -b do stata_bench.do        (or: do stata_bench.do from the Stat
> a prompt)
. *
. * Data are read in double precision (import delimited reads float by default)
> .
. * Default maximize options. Each scenario is timed with 1 processor and, on S
> tata/MP,
. * with all licensed processors. The reported time is the median of 3 fits (da
> ta already
. * in memory). Output: results/stata.csv and results/stata_coef.csv, in the sa
> me layout
. * as the Julia and R results, so report.jl can merge them.
. 
. version 15

. set more off

. local scenarios pairs match1to4 choice multi panelfe bigstrata choicelarge

. local reps 3

. local procs 1

. if c(MP) & c(processors_max) > 1 local procs 1 `c(processors_max)'

. 
. tempname res coefs

. postfile `res' str16 scenario str24 tool threads rows double seconds iteratio
> ns double loglik ///
>     using "results/stata_raw.dta", replace
(note: file results/stata_raw.dta not found)

. postfile `coefs' str16 scenario str8 term double estimate using "results/stat
> a_coef_raw.dta", replace
(note: file results/stata_coef_raw.dta not found)

. 
. foreach sc of local scenarios {
  2.     import delimited using "data/`sc'.csv", clear asdouble
  3.     unab xs : x*
  4.     foreach np of local procs {
  5.         if c(MP) set processors `np'
  6.         matrix T = J(`reps', 1, .)
  7.         forvalues r = 1/`reps' {
  8.             timer clear 1
  9.             timer on 1
 10.             quietly clogit y `xs', group(s)
 11.             timer off 1
 12.             quietly timer list 1
 13.             matrix T[`r', 1] = r(t1)
 14.         }
 15.         mata: st_numscalar("med", sort(st_matrix("T"), 1)[ceil(rows(st_mat
> rix("T")) / 2)])
 16.         post `res' ("`sc'") ("Stata clogit") (`np') (_N) (scalar(med)) (e(
> ic)) (e(ll))
 17.         display "`sc'" _col(14) _N " rows  " %8.4f scalar(med) " s  (" e(i
> c) " iterations, `np' processors)"
 18.     }
 19.     foreach x of local xs {
 20.         post `coefs' ("`sc'") ("`x'") (_b[`x'])
 21.     }
 22. }
(7 vars, 40,000 obs)
    The maximum number of processors or cores being used is changed from 16
    to 1.  It can be set to any number between 1 and 16
